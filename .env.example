# Optional local configuration. Do not commit an actual .env file.
# Or enter provider keys per-run via New evaluation > Model connections.
# Use the HUMAIN API base URL supplied for your account/environment.
# The public SDK example uses https://api.voice.humain.com.
HUMAIN_API_KEY=
HUMAIN_API_URL=https://api.voice.humain.com
HUMAIN_API_PATH=/socket.io
ELEVENLABS_API_KEY=
# Do not add HUMAIN_MODEL here: the adapter selects the model by language mode.
