{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASR batch manifest",
  "type": "object",
  "required": [
    "cases"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "source",
          "ground_truth"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,90}$"
          },
          "title": {
            "type": "string"
          },
          "ground_truth": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "sample",
                  "youtube",
                  "upload"
                ]
              },
              "url": {
                "type": "string"
              },
              "upload_id": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              }
            }
          },
          "crop": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "reference_confirmed": {
            "type": "boolean",
            "description": "Set true only after reviewing this reference against the selected audio. Required when reusing the bundled reference with a non-sample source."
          }
        }
      }
    }
  }
}